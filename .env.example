# Copy this file to ".env" and fill in your own values.
# Never commit ".env" (it is in .gitignore).

# --- Required (the server stops if one is missing) ---

# MongoDB connection string. Local example:
MONGO_URI=mongodb://localhost:27017/myapp_db
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Secret for signing admin login tokens (JWT). Use a long random string.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The only origin CORS allows: the frontend address (no "/" at the end).
# Local: http://localhost:5173   Phone on the same Wi-Fi: http://<your-PC-IP>:5173
FRONTEND_URL=http://localhost:5173

# --- Optional ---

# Server port (default 5000)
PORT=5000

# Adds GET /api/orders/:id/confirmation for the future WhatsApp bot.
# Keep it "false" until the bot exists.
WHATSAPP_BOT_ENABLED=false

# --- Only for "node scripts/addAdmin.js" (first admin account) ---
# Remove ADMIN_PASSWORD from .env after the admin is created.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-strong-password-8-to-72-chars
# ADMIN_FULL_NAME=المدير العام
# ADMIN_ROLE=super_admin
